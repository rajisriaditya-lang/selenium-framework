<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="LoginRegressionSuite" parallel="tests" thread-count="2" verbose="1">

    <test name="ChromeLoginTests">
        <parameter name="browser" value="chrome"/>

        <classes>
            <class name="com.myproject.tests.LoginTest">
                <methods>
                    <include name="tc01_validLoginTest"/>
                    <include name="tc02_invalidPasswordTest"/>
                    <include name="tc03_blankUsernameTest"/>
                    <include name="tc04_logoutTest"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>
